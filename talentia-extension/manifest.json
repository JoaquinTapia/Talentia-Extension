{
  "manifest_version": 3,
  "name": "TalentIA",
  "short_name": "TalentIA",
  "description": "AI Copilot for Job Search",
  "version": "0.1.0",

  "action": {
    "default_title": "TalentIA",
    "default_popup": "popup/popup.html"
  },

  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },

  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://localhost:3000/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*"
      ],
      "js": [
        "content/linkedin/index.js"
      ],
      "run_at": "document_idle"
    }
  ]
}