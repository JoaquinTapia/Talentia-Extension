{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",

    "lib": [
      "DOM",
      "ES2022"
    ],

    "strict": true,

    "esModuleInterop": true,

    "skipLibCheck": true,

    "outDir": "dist",

    "rootDir": "src",

    "types": [
      "chrome"
    ]
  },

  "include": [
    "src/**/*.ts"
  ]
}